# ── Server ──
PORT=4011
NODE_ENV=development

# ── Database (Cloud SQL PostgreSQL) ──
# 검색앱 전용 읽기 계정 search_app. search 스키마 소유 + susi/jungsi SELECT.
# dev 예시:
DATABASE_URL="postgresql://search_app:PASSWORD@localhost:5432/geobukschool_dev?schema=search"
# prod(App Engine, Cloud SQL 소켓):
# DATABASE_URL="postgresql://search_app:PASSWORD@/geobukschool_prod?host=/cloudsql/ts-back-nest-479305:asia-northeast3:geobuk-db&schema=search"

# 외부 읽기 대상 스키마 (multiSchema raw read)
SOURCE_SCHEMA_SUSI=susi
SOURCE_SCHEMA_JUNGSI=jungsi

# 앱 내 cron 증분 동기화 사용 여부 (운영은 Cloud Scheduler 권장 → false)
SYNC_CRON_ENABLED=false

# ── Hub SSO ──
HUB_BASE_URL=https://www.tskool.kr
HUB_API_URL=https://ts-back-nest-479305.du.r.appspot.com
# 절대 변경 금지(전 생태계 세션 무효화). Base64 인코딩된 secret.
AUTH_JWT_SECRET=
# 서버-서버(Hub 프로파일 API) 호출용. AUTH_JWT_SECRET과 별개.
AUTH_SERVICE_SECRET=
SERVICE_ID=search

# ── Vertex AI ──
GCP_PROJECT_ID=ts-back-nest-479305
GCP_LOCATION=asia-northeast3
VERTEX_EMBEDDING_MODEL=text-embedding-004
VERTEX_GENERATION_MODEL=gemini-1.5-pro

# guide 모듈(@google/genai)이 실제로 읽는 변수. 위 GCP_*/VERTEX_* 와 별개다.
# App Engine은 GOOGLE_CLOUD_PROJECT를 자동 주입하지만 LOCATION은 주입하지 않는다.
GOOGLE_CLOUD_PROJECT=ts-back-nest-479305
GOOGLE_CLOUD_LOCATION=asia-northeast3
GUIDE_GEN_MODEL=gemini-2.5-flash
# 적재 스크립트 실행 시에도 위 두 GOOGLE_CLOUD_* 가 필요:
#   npx ts-node scripts/guide/ingest.ts
