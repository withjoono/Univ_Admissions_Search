// 검색앱 Prisma 스키마.
// 원칙: 본 앱이 소유/마이그레이션하는 것은 `search` 스키마뿐.
// 외부 스키마(susi/jungsi 전형)는 여기 모델로 두지 않고, sync 모듈에서 $queryRaw 읽기 전용으로 접근.
// (마이그레이션이 외부 스키마를 건드리지 않도록 의도적으로 분리 — docs/데이터연동-multiSchema-계획.md §3.2 패턴 A)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL") // ?schema=search 로 search 스키마에 생성
  extensions = [vector]            // pgvector
}

/// 정규화된 통합 전형 (grain = 대학·모집단위·전형·연도)
model SrchAdmission {
  id                Int      @id @default(autoincrement())
  trackType         String   @map("track_type") // SUSI | JEONGSI
  curriculum        String   @default("Y2015") // Y2015 | Y2022
  year              Int

  universityName    String   @map("university_name")
  region            String?
  establishmentType String?  @map("establishment_type")
  departmentName    String   @map("department_name") // 모집단위
  fieldGeneral      String?  @map("field_general")
  fieldMajor        String?  @map("field_major")
  fieldMid          String?  @map("field_mid")
  fieldMinor        String?  @map("field_minor")

  admissionType     String   @map("admission_type")
  admissionName     String   @map("admission_name")
  recruitmentNumber Int?     @map("recruitment_number")

  ratios            Json?    // {수능,교과,서류,면접,실기 비율}
  csatRequired      String?  @map("csat_required")
  minGradeDesc      String?  @map("min_grade_desc")
  hasInterview      Boolean  @default(false) @map("has_interview")
  prevResults       Json?    @map("prev_results") // 연도별 입결/경쟁률
  riskBand          Json?    @map("risk_band")

  descriptionText   String   @map("description_text") // 검색/임베딩용 통합 텍스트

  sourceApp         String   @map("source_app")        // susi | jungsi
  sourceId          String   @map("source_id")
  sourceUpdatedAt   DateTime? @map("source_updated_at")
  syncedAt          DateTime @default(now()) @map("synced_at")

  embedding         SrchEmbedding?

  @@unique([sourceApp, sourceId], name: "uq_source")
  @@index([trackType, curriculum, year])
  @@index([region])
  @@map("srch_admission")
}

/// 임베딩 벡터 (text-embedding-004 = 768차원, 모델 변경 시 차원 조정)
model SrchEmbedding {
  admissionId Int                          @id @map("admission_id")
  embedding   Unsupported("vector(768)")?
  model       String
  updatedAt   DateTime                     @default(now()) @map("updated_at")

  admission   SrchAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@map("srch_embedding")
}

/// 동기화 이력
model SrchSyncLog {
  id           Int       @id @default(autoincrement())
  sourceApp    String    @map("source_app")
  mode         String    // full | incremental
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  rowsRead     Int       @default(0) @map("rows_read")
  rowsUpserted Int       @default(0) @map("rows_upserted")
  status       String    @default("running") // running | success | failed
  error        String?

  @@map("srch_sync_log")
}

// =====================================================================
// 진학지도 자료(특별전형 목록 + 서술형 해설) — PDF 자료집 적재분
// scripts/guide/* 파이프라인이 채운다. susi/jungsi 라이브 전형과 별개 출처.
// =====================================================================

/// 특별전형·예체능(비실기) 목록형 데이터 (정형 표 → 필터 검색용)
/// grain = 자료 한 행(대학·모집단위·전형). PDF 표에서 추출.
model SrchGuideAdmission {
  id                Int      @id @default(autoincrement())
  year              Int      @default(2027)
  category          String   // 농어촌학생 | 지역인재 | 특성화고졸업자 | 예체능-미술계열(비실기) ...

  region            String?  // 지역/권역 (병합셀 forward-fill 반영)
  universityName    String   @map("university_name")
  departmentName    String?  @map("department_name") // 모집단위(있을 때)
  admissionType     String?  @map("admission_type")  // 교과 | 종합 | 논술 ...
  admissionName     String?  @map("admission_name")

  recruitmentText   String?  @map("recruitment_text")   // 원문 그대로("(36)" 등 미확정 표기 보존)
  recruitmentNumber Int?     @map("recruitment_number") // 파싱 가능하면 숫자
  method            String?  // 전형방법(예: 학생부100)
  csatMinDesc       String?  @map("csat_min_desc")      // 수능최저학력기준(있을 때)
  note              String?  // 비고

  searchText        String   @map("search_text")        // 평탄화 검색/임베딩 텍스트
  raw               Json                                 // 원본 추출 행 보존
  sourceFile        String   @map("source_file")
  sourcePage        Int      @map("source_page")
  syncedAt          DateTime @default(now()) @map("synced_at")

  @@index([category, year])
  @@index([region])
  @@index([universityName])
  @@map("srch_guide_admission")
}

/// 서술형 자료 청크 (계열별 분석·상담 자료집·지역의사 안내 등) — RAG 근거
model SrchKnowledgeChunk {
  id         Int      @id @default(autoincrement())
  year       Int      @default(2027)
  doc        String   // 계열별분석 | 상담자료집 | 지역의사안내
  title      String
  page       Int
  text       String                                       // 근거로 인용될 원문 청크

  sourceFile String?  @map("source_file")
  createdAt  DateTime @default(now()) @map("created_at")

  embedding  SrchKnowledgeEmbedding?

  @@index([doc, year])
  @@map("srch_knowledge_chunk")
}

/// 청크 임베딩 벡터 (gemini-embedding-001, outputDimensionality=768 → 기존 SrchEmbedding과 차원 통일)
model SrchKnowledgeEmbedding {
  chunkId   Int                          @id @map("chunk_id")
  embedding Unsupported("vector(768)")?
  model     String
  updatedAt DateTime                     @default(now()) @map("updated_at")

  chunk     SrchKnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@map("srch_knowledge_embedding")
}
